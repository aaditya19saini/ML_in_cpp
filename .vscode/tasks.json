{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "g++: build and run active file",
            "type": "shell",
            "command": "g++ -std=c++23 -Wall \"${file}\" -o \"/tmp/${fileBasenameNoExtension}\" && \"/tmp/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
